// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}



enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  BENSIN
  DIESEL
  ELECTRIC
  HYBRID
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  phone     String?
  address   String?   @db.Text
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blogPosts BlogPost[]

  @@map("users")
}

model Car {
  id           String       @id @default(cuid())
  name         String
  brand        String
  type         String   @default("MOBIL")
  pricePerDay  Int
  seats        Int
  transmission Transmission
  fuel         FuelType
  description  String       @db.Text
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  withDriverOnly Boolean    @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bookings     Booking[]
  galleryItems GalleryItem[]

  @@index([isAvailable])
  @@index([createdAt])
  @@map("cars")
}

model Booking {
  id                String        @id @default(cuid())
  carId             String
  carName           String
  carBrand          String
  carType           String
  customerName      String
  customerWa        String
  pickupDate        DateTime
  duration          Int
  endDate           DateTime
  pickupLocation    String
  driverOption      String
  selectedAdminName String
  selectedAdminWa   String
  pricePerDay       Int
  totalPrice        Int
  status            BookingStatus @default(PENDING_CONFIRMATION)
  customerNote      String?       @db.Text
  adminNote         String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String    @db.Text
  imageUrl        String?
  category        String?
  tags            String?
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  authorId        String
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@map("blog_posts")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  carId       String?
  createdAt   DateTime @default(now())

  car Car? @relation(fields: [carId], references: [id], onDelete: SetNull)

  @@map("gallery_items")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("faq_items")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_configs")
}

model Review {
  id         String   @id @default(cuid())
  reviewerName String
  reviewerAvatar String?
  rating     Int      @default(5)
  content    String   @db.Text
  source     String   @default("Google")
  reviewDate String?
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("reviews")
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  ipAddress String?
  userAgent String?  @db.Text
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page])
  @@map("page_views")
}
